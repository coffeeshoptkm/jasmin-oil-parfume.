
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600&display=swap');

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  background: #0b0b0b;
  color: #f5f1e8;
  font-family: 'Montserrat', sans-serif;
}

button, input {
  font: inherit;
}

.header {
  text-align: center;
  padding: 30px 15px;
  border-bottom: 1px solid #aa8b50;
}

.header h1,
footer h2 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 42px;
  letter-spacing: 8px;
}

.header > p {
  color: #c5a568;
  font-size: 10px;
  letter-spacing: 5px;
  margin-top: 5px;
}

nav {
  display: flex;
  justify-content: center;
  gap: 35px;
  margin-top: 25px;
}

nav a {
  color: #f5f1e8;
  text-decoration: none;
  font-size: 11px;
  letter-spacing: 2px;
}

nav a:hover {
  color: #c5a568;
}

.hero {
  min-height: 520px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 70px 20px;
  background: radial-gradient(ellipse at center, #292117, #0b0b0b 70%);
}

.gold-text {
  color: #c5a568;
  font-size: 11px;
  letter-spacing: 4px;
  margin-bottom: 22px;
}

.hero h2,
.catalog h2,
.about h2 {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(38px, 7vw, 65px);
  font-weight: 400;
  margin-bottom: 18px;
}

.hero > p:not(.gold-text) {
  color: #aaa;
  font-size: 13px;
}

.hero-button {
  display: inline-block;
  margin-top: 35px;
  padding: 15px 28px;
  border: 1px solid #c5a568;
  color: #c5a568;
  text-decoration: none;
  font-size: 10px;
  letter-spacing: 2px;
  transition: .3s;
}

.hero-button:hover {
  background: #c5a568;
  color: #111;
}

.catalog {
  padding: 90px 7%;
  text-align: center;
}

.catalog h2 {
  font-size: 48px;
}

#search {
  width: min(100%, 420px);
  padding: 14px 18px;
  margin: 25px auto;
  background: #151515;
  border: 1px solid #665333;
  color: white;
  outline: none;
}

.filters {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10px;
  margin: 15px 0 40px;
}

.filters button {
  padding: 11px 20px;
  background: transparent;
  color: #c5a568;
  border: 1px solid #665333;
  cursor: pointer;
  font-size: 10px;
  letter-spacing: 1px;
}

.products {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 25px;
  max-width: 1200px;
  margin: auto;
}

.product-card {
  position: relative;
  padding: 18px;
  background: #121212;
  border: 1px solid #29241c;
  text-align: left;
  transition: transform .25s, border-color .25s;
  cursor: pointer;
}

.product-card:hover {
  transform: translateY(-5px);
  border-color: #aa8b50;
}

.product-image {
  display: block;
  width: 100%;
  height: 260px;
  object-fit: contain;
  background: radial-gradient(ellipse, #29231b, #101010);
}

.brand-label {
  color: #c5a568;
  font-size: 10px;
  letter-spacing: 2px;
  margin-top: 18px;
  text-transform: uppercase;
}

.product-name-bg {
  color: #f5f1e8;
  font-family: 'Cormorant Garamond', serif;
  font-size: 24px;
  margin-top: 8px;
}

.product-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 18px;
  color: #aaa;
  font-size: 12px;
}

.price {
  color: #c5a568;
  font-size: 15px;
}

.about {
  padding: 90px 20px;
  text-align: center;
  background: #12100d;
}

.about h2 {
  font-size: 45px;
}

.about > p:last-child {
  color: #aaa;
  font-size: 13px;
  line-height: 1.8;
}

footer {
  padding: 45px 20px;
  text-align: center;
  border-top: 1px solid #665333;
}

footer h2 {
  font-size: 32px;
}

footer p {
  color: #c5a568;
  font-size: 10px;
  letter-spacing: 3px;
  margin-top: 10px;
}

footer p:last-child {
  color: #777;
  margin-top: 25px;
}

@media (max-width: 600px) {
  nav {
    gap: 18px;
  }

  nav a {
    font-size: 9px;
  }

  .catalog {
    padding: 60px 15px;
  }

  .products {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .product-card {
    padding: 10px;
  }

  .product-image {
    height: 190px;
  }

  .product-name-bg {
    font-size: 19px;
  }
}
