const volumes = [10, 20, 50, 100];
const favoritesKey = "jasmin_oil_favorites";

const productsContainer = document.querySelector("#products");
const searchInput = document.querySelector("#search");
const filters = document.querySelector(".filters");

let currentCategory = "All";
let favoritesOnly = false;
let selectedProduct = null;
let selectedVolume = 10;

function loadFavorites() {
  try {
    const data = JSON.parse(localStorage.getItem(favoritesKey));
    return Array.isArray(data) ? data : [];
  } catch {
    return [];
  }
}

let favorites = loadFavorites();

function saveFavorites() {
  try {
    localStorage.setItem(favoritesKey, JSON.stringify(favorites));
  } catch (error) {
    console.warn("Favorites could not be saved:", error);
  }
}

function isFavorite(index) {
  return favorites.includes(index);
}

function priceText(price) {
  return price.toLocaleString("ru-RU") + " TMT";
}

function getPrice(product, volume) {
  return product.price * volume / 10;
}

// ИЗБРАННОЕ

const favoritesButton = document.createElement("button");
favoritesButton.type = "button";
favoritesButton.className = "filter favorites-filter";
favoritesButton.textContent = "♡ FAVORITES";
filters.appendChild(favoritesButton);

function updateFavoritesButton() {
  favoritesButton.textContent =
    favoritesOnly ? "♥ FAVORITES" : "♡ FAVORITES";

  favoritesButton.classList.toggle("active", favoritesOnly);
}

// КАТАЛОГ

function showProducts() {
  const query = searchInput.value.toLowerCase().trim();

  const filtered = products
    .map((product, index) => ({ ...product, index }))
    .filter(product => {
      const categoryMatch =
        currentCategory === "All" ||
        product.category === currentCategory;

      const searchMatch =
        product.name.toLowerCase().includes(query) ||
        product.brand.toLowerCase().includes(query);

      const favoriteMatch =
        !favoritesOnly || isFavorite(product.index);

      return categoryMatch && searchMatch && favoriteMatch;
    });

  productsContainer.innerHTML = filtered.length
    ? filtered.map(product => `
      <article class="product-card" data-index="${product.index}">

        <button
          class="favorite-toggle ${isFavorite(product.index) ? "is-favorite" : ""}"
          data-index="${product.index}"
          type="button"
        >${isFavorite(product.index) ? "♥" : "♡"}</button>

        <img
          class="product-image"
          src="${product.image}"
          alt="${product.brand} ${product.name}"
          loading="lazy"
        >

        <div class="brand-label">${product.brand}</div>
        <div class="product-name-bg">${product.name}</div>

        <div class="product-info">
          <p>10 ml</p>
          <p class="price">${priceText(product.price)}</p>
        </div>

        <p class="open-hint">VIEW DETAILS</p>
      </article>
    `).join("")
    : '<p class="empty-products">No fragrances found.</p>';

  document.querySelectorAll(".filter[data-category]").forEach(button => {
    button.classList.toggle(
      "active",
      !favoritesOnly && button.dataset.category === currentCategory
    );
  });

  updateFavoritesButton();
}

