// ИЗБРАННОЕ БЕЗ ПОЛНОЙ ПЕРЕРИСОВКИ

function updateFavoriteIcons(index) {
  const favorite = isFavorite(index);

  productsContainer
    .querySelectorAll(`.favorite-toggle[data-index="${index}"]`)
    .forEach(button => {
      button.textContent = favorite ? "♥" : "♡";
      button.classList.toggle("is-favorite", favorite);
    });

  updateFavoritesButton();

  if (selectedProduct === index) {
    updateModalFavorite();
  }
}

function toggleFavorite(index) {
  if (isFavorite(index)) {
    favorites = favorites.filter(id => id !== index);
  } else {
    favorites.push(index);
  }

  saveFavorites();

  if (favoritesOnly) {
    showProducts();
  } else {
    updateFavoriteIcons(index);
  }
}

// ОТКРЫТИЕ КАРТОЧКИ

function openProduct(index) {
  selectedProduct = index;
  selectedVolume = 10;

  const product = products[index];

  modal.querySelector(".modal-image").src = product.image;
  modal.querySelector(".modal-image").alt = product.name;
  modal.querySelector(".modal-brand").textContent = product.brand;
  modal.querySelector(".modal-name").textContent = product.name;
  modal.querySelector(".modal-description").textContent = product.description;

  updateVolumeButtons();
  updateModalPrice();
  updateModalFavorite();

  modal.classList.add("open");
  document.body.style.overflow = "hidden";
}

function updateModalPrice() {
  const product = products[selectedProduct];

  modal.querySelector(".modal-price").textContent =
    priceText(getPrice(product, selectedVolume));
}

function updateVolumeButtons() {
  modal.querySelectorAll(".volume-button").forEach(button => {
    button.classList.toggle(
      "active",
      Number(button.dataset.volume) === selectedVolume
    );
  });
}

function updateModalFavorite() {
  if (selectedProduct === null) return;

  modal.querySelector(".modal-favorite").textContent =
    isFavorite(selectedProduct)
      ? "♥ REMOVE FROM FAVORITES"
      : "♡ ADD TO FAVORITES";
}

// СОБЫТИЯ

productsContainer.addEventListener("click", event => {
  const favoriteButton = event.target.closest(".favorite-toggle");

  if (favoriteButton) {
    event.stopPropagation();
    toggleFavorite(Number(favoriteButton.dataset.index));
    return;
  }

  const card = event.target.closest(".product-card");

  if (card) {
    openProduct(Number(card.dataset.index));
  }
});

modal.querySelector(".volume-options").addEventListener("click", event => {
  const button = event.target.closest(".volume-button");
  if (!button) return;

  selectedVolume = Number(button.dataset.volume);
  updateVolumeButtons();
  updateModalPrice();
});

modal.querySelector(".modal-favorite").addEventListener("click", () => {
  if (selectedProduct !== null) {
    toggleFavorite(selectedProduct);
  }
});

function closeModal() {
  modal.classList.remove("open");
  document.body.style.overflow = "";
  selectedProduct = null;
}

modal.querySelector(".modal-close").addEventListener("click", closeModal);

modal.addEventListener("click", event => {
  if (event.target === modal) closeModal();
});

document.addEventListener("keydown", event => {
  if (event.key === "Escape" && modal.classList.contains("open")) {
    closeModal();
  }
});

// ПОИСК И ФИЛЬТРЫ

searchInput.addEventListener("input", showProducts);

document.querySelectorAll(".filter[data-category]").forEach(button => {
  button.addEventListener("click", () => {
    currentCategory = button.dataset.category;
    favoritesOnly = false;
    showProducts();
  });
});

favoritesButton.addEventListener("click", () => {
  favoritesOnly = !favoritesOnly;
  showProducts();
});

// ЗАПУСК

showProducts();
